# Keep explicit example/sample configs only.
/Conquest-Launcher-Backend/appsettings.json
/Conquest-Launcher-Backend/appsettings.*.json
!/Conquest-Launcher-Backend/appsettings.*.example.json
!/Conquest-Launcher-Backend/appsettings.*.sample.json

