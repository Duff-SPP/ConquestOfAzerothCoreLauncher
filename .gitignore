/conquest-launcher/build/coa-dirs.txt

# Addon payload is supplied separately.
# Keep a README in this directory if one is added.
/conquest-launcher/src/assets/AddonCatalog/*
!/conquest-launcher/src/assets/AddonCatalog/README.md

