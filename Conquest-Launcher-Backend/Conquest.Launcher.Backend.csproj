<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.6.0</Version>
    <UserSecretsId>conquest-launcher-backend-local</UserSecretsId>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="MySqlConnector" Version="2.6.2" /></ItemGroup>
  <ItemGroup>
    <Content Remove="appsettings.Local.json" />
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
    <Content Remove="**/*.log;**/*.env;**/*.bin" />
    <Content Remove="deploy/**;test-output/**" />
    <Compile Remove="deploy/**;test-output/**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../COPYING" Link="COPYING" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../ATTRIBUTION.md" Link="ATTRIBUTION.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
