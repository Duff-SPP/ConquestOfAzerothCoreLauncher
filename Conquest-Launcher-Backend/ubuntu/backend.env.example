ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5082
LocalTesting=false
AllowedHosts=launcher-api.coa-development.org
Portal__PublicBaseUrl=https://launcher-api.coa-development.org
DataProtection__KeysPath=/var/lib/coa-launcher-backend/keys
Launcher__PublishedRoot=/srv/coa/published

# Set privately on the VPS. Do not copy the desktop repack's credentials.
# Use the VPS MySQL port (not necessarily the desktop repack's 3307).
ConnectionStrings__AuthDatabase=
ConnectionStrings__CharactersDatabase=
# Example value format: Server=127.0.0.1;Port=3306;Database=acore_auth;User ID=coa_launcher;Password=your-private-password;Connection Timeout=5

# Account registration uses validation and rate limits; CAPTCHA is optional.
Accounts__RegistrationEnabled=true
Turnstile__Enabled=false
Turnstile__SiteKey=
Turnstile__SecretKey=
Turnstile__ExpectedAction=register
Turnstile__AllowedHostnames__0=launcher-api.coa-development.org

# Optional account linking. Create tables and fill secrets before enabling.
DiscordOAuth__Enabled=false
DiscordOAuth__ClientId=
DiscordOAuth__ClientSecret=
DiscordOAuth__RedirectUri=https://launcher-api.coa-development.org/api/account/discord/callback
DiscordOAuth__StateMinutes=10

# Optional password recovery: apply sql/password-reset.sql and configure SMTP first.
Portal__PasswordResetEnabled=false
Smtp__Host=
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=Conquest of AzerothCore
